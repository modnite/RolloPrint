*GPDFileName: "Rollo.gpd"
*GPDFileVersion: "1.4"
*GPDSpecVersion: "1.0"
*ModelName: "Rollo"
*MasterUnits: PAIR(203, 203)
*Include: "StdNames.gpd"
*ResourceDLL: "RolloRES.DLL"
*PrinterType: SERIAL

*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: PORTRAIT
    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }
    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}
*%******************************************************************************************
*%                                      Input Bin
*%******************************************************************************************
*Feature: InputBin
{
	*rcNameID: =PAPER_SOURCE_DISPLAY
	*DefaultOption: Option1
	*Option: Option1
	{
		*rcNameID: 25001
	}
}

*%******************************************************************************************
*%                                      Resolution
*%******************************************************************************************
*Feature: Resolution
{
	*rcNameID: =RESOLUTION_DISPLAY
	*DefaultOption: Option1
	*Option: Option1
	{
		*Name: "8 dots per mm"
	        *Command: CmdSendBlockData { *Cmd : ""}

		*DPI: PAIR(203, 203)
		*PinsPerLogPass: 24
		*PinsPerPhysPass: 1
		*TextDPI: PAIR(203, 203)
		*SpotDiameter: 100
    }
}

*%******************************************************************************************
*%                                      Paper Size
*%******************************************************************************************
*Feature: PaperSize
{
	*rcNameID: =PAPER_SIZE_DISPLAY
	*DefaultOption: Option8	
	*Option: Option1
	{		
		*Name: "94mm x 145mm"
		*PageDimensions: PAIR(752, 1160)
		*PrintableArea: PAIR(752, 1160)
		*PrintableOrigin: PAIR(0, 0)
	}
	*Option: Option2
	{		
		*Name: "94mm x 150mm"
		*PageDimensions: PAIR(752, 1200)
		*PrintableArea: PAIR(752, 1200)
		*PrintableOrigin: PAIR(0, 0)
