	*Option: CUSTOMSIZE
	{
		*rcNameID: =USER_DEFINED_SIZE_DISPLAY
		*MinSize: PAIR(24, 24)
		*MaxSize: PAIR(840, 8000)
		*MaxPrintableWidth: 840
		*MinLeftMargin: 0
		*TopMargin: 0
		*BottomMargin: 0
		*CenterPrintable?: TRUE
		*CursorOrigin: PAIR(0, 0)
	}
}

*Feature: Halftone
{
    *rcNameID: =HALFTONING_DISPLAY
    *DefaultOption: HT_PATSIZE_2x2_M
    *Option: HT_PATSIZE_AUTO
    {
        *rcNameID: =HT_AUTO_SELECT_DISPLAY
    }
    *Option: HT_PATSIZE_2x2_M
    {
        *Name:"None"
    }
*Ifdef: WINNT_50
    *Option: HT_PATSIZE_SUPERCELL_M
    {
        *rcNameID: =HT_SUPERCELL_DISPLAY
    }
*Endif:
    *Option: HT_PATSIZE_6x6_M
    {
        *rcNameID: =HT_DITHER6X6_DISPLAY
    }
    *Option: HT_PATSIZE_8x8_M
    {
        *rcNameID: =HT_DITHER8X8_DISPLAY
    }
}


*Feature: ColorMode
{
	*rcNameID: =COLOR_PRINTING_MODE_DISPLAY
	*DefaultOption: Mono
	*Option: Mono
	{
		*rcNameID: =MONO_DISPLAY
		*DevNumOfPlanes: 0
		*DevBPP: 0
		*IPCallbackID: 1
		*Color?: FALSE
	}
}
*%******************************************************************************************
*%                General Printing Attributes(Capability, Color, Cursor)
*%******************************************************************************************
*%MemoryUsage: LIST(FONT, RASTER, VECTOR)
*%OEMCustomData: ""
*%OutputOrderReversed?: FALSE
*%ReselectFont: LIST(AFTER_GRXDATA, AFTER_XMOVE, AFTER_FF)
*%ReverseBandOrderForEvenPages?: FALSE
*%ReverseBandOrderForEvenPages?: FALSE
*%RotateFont?: FALSE
*%RotateRaster?: FALSE
*%TextCaps: TC_xxx


*AbsXMovesRightOnly?: FALSE
*%BadCursorMoveInGrxMode: LIST(X_PORTRAIT, X_LANDSCAPE, Y_PORTRAIT, Y_LANDSCAPE)
*CursorXAfterCR: AT_PRINTABLE_X_ORIGIN
*EjectPageWithFF?: TRUE
*%LineSpacingMoveUnit: 1
*%MaxLineSpacing: 0
*UseSpaceForXMove?: FALSE
*%XMoveThreshold: 0
*XMoveUnit: 203
*YMoveAttributes: SEND_CR_FIRST
*YMoveThreshold: *
*YMoveUnit: 203

*%******************************************************************************************
*%               Text Printing Attributes(Device, Downloaded, Simulated)
*%******************************************************************************************

*%******************************************************************************************
*%                 Raster Printing Attributes(Compression, Emission)
*%******************************************************************************************
*CursorXAfterSendBlockData: AT_CURSOR_X_ORIGIN
*CursorYAfterSendBlockData: NO_MOVE
*OptimizeLeftBound?: FALSE
*OutputDataFormat: H_BYTE
*RasterSendAllData?: TRUE
*%StripBlanks: TRAILING

*%******************************************************************************************
*%                             Vector Printing Attributes
*%******************************************************************************************


*%******************************************************************************************
*%                       General Printing Commands(Color, Cursor)
*%******************************************************************************************
*Command: CmdCR: ""
*Command: CmdLF: ""
*Command: CmdFF: ""
*Command: CmdXMoveAbsolute: ""
*Command: CmdYMoveRelDown: ""

*Command: CmdStartDoc
{
	*Order: DOC_SETUP.1
	*Cmd: ""
}
*Command: CmdEndDoc
{
    *Order: DOC_FINISH.1
    *Cmd: ""
}
*Command: CmdEndPage
{
    *Order: PAGE_FINISH.1
    *Cmd: ""
}
*Command: CmdEndJob
{
    *Order: JOB_FINISH.1
    *Cmd: ""
}


